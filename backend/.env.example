# Copy to .env and fill in values
FLASK_DEBUG=1
SECRET_KEY=change-me
PORT=5001

# Firebase (see README > Firebase setup)
FIREBASE_CREDENTIALS=firebase-service-account.json
FIREBASE_API_KEY=your-web-api-key

# Invite codes for new streamer accounts (comma-separated). Viewers don't need one.
STREAMER_INVITE_CODES=1STTEACHERS,CREATOR
